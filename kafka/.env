# =============================================================================
# Kafka Stack — Host Port Configuration
# Edit values here to remap any host-side port. Internal container ports
# are fixed and do not need to change.
# =============================================================================

BROKER_PORT=9092
BROKER_JMX_PORT=9101
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083
AKHQ_PORT=8080
CONTROL_CENTER_PORT=9021
KSQLDB_PORT=8088
REST_PROXY_PORT=8082

# Container names — override if you need to run alongside another stack
AKHQ_CONTAINER_NAME=akhq
